/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"

#define LED_DELAY (100000000)
#define MAX_COUNT (0xF)
#define MAX_BITS (4)

int main()
{
    XGpio Gpio0, Gpio1, Gpio2;
    int Status;
    u32 sw;
    volatile int delay;

	init_platform();

    xil_printf("Hello World\r\n");

    // Refer to xparameters.h
    Status = XGpio_Initialize(&Gpio0, XPAR_AXI_GPIO_0_DEVICE_ID);
    Status = XGpio_Initialize(&Gpio1, XPAR_AXI_GPIO_1_DEVICE_ID);
    Status = XGpio_Initialize(&Gpio2, XPAR_AXI_GPIO_2_DEVICE_ID);

    if (Status != XST_SUCCESS)
    {
    	xil_printf("GPIO Initialization Failed.\r\n");
    	return XST_FAILURE;
    }

    xil_printf("GPIO has successfully initialized.\r\n");

    // Refer to xgpio.c for function implementation
    XGpio_SetDataDirection(&Gpio0, 1, 0xF);
    XGpio_SetDataDirection(&Gpio1, 1, 0xF);
    XGpio_SetDataDirection(&Gpio2, 1, 0xF);

    while(1)
    {

    	// Read switch values
    	sw = XGpio_DiscreteRead(&Gpio2, 1);
    	//xil_printf("switch value: 0x%x\r\n", sw);
    	if (sw == 0x1) XGpio_DiscreteWrite(&Gpio1, 1, 0x1);
    	else if (sw == 0x2) XGpio_DiscreteWrite(&Gpio1, 1, 0x2);
    	else if (sw == 0x4) XGpio_DiscreteWrite(&Gpio1, 1, 0x4);
    	else if (sw == 0x8) XGpio_DiscreteWrite(&Gpio1, 1, 0x7);
    	else if (sw == 0x3)
    	{
    		// Turn of RGB LED
    		XGpio_DiscreteWrite(&Gpio1, 1, 0x0);

    		// Binary count loop
    		int count;
    		for (count = 0; count <= MAX_COUNT; count++)
    		{
    			XGpio_DiscreteWrite(&Gpio0, 1, count);
    			for (delay = 0; delay < LED_DELAY; delay++);
    		}
    	}
    	else if (sw == 0xC)
    	{
    		// Turn off RGB LED
    		XGpio_DiscreteWrite(&Gpio1, 1, 0x0);

    		// Ring count loop
    		int pos;
    		int count = 0;
    		for (pos = 0; pos < MAX_BITS; pos ++)
    		{
    			count = count << 1;
    			XGpio_DiscreteWrite(&Gpio0, 1, count);
    			for (delay = 0; delay < LED_DELAY; delay++);
    		}
    	}
    	else
    	{
    		XGpio_DiscreteWrite(&Gpio0, 1, 0x0);
    		XGpio_DiscreteWrite(&Gpio1, 1, 0x0);
    	}

    	for (delay = 0; delay < LED_DELAY; delay++);

    	/*Old Code*/

//    	// Set the LED to 1
//    	XGpio_DiscreteWrite(&Gpio, 1, 0xF);
//    	xil_printf("LED high\r\n");
//
//    	// Wait a small amount of time
//    	for (delay = 0; delay < LED_DELAY; delay++);
//
//    	// Clear the LED to 0
//    	XGpio_DiscreteClear(&Gpio, 1, 0xF);
//    	xil_printf("LED low\r\n");
//
//    	// Wait a small amount of time
//    	for (delay = 0; delay < LED_DELAY; delay++);
    }

    return 0;
}
